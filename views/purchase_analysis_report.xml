<odoo>
    <record id = "view_purchase_analysis_report_list" model="ir.ui.view">
        <field name="name">purchase.analysis.report.list</field>
        <field name="model">purchase.analysis.report</field>
        <field name="arch" type="xml">
            <list string="Purchase Analysis report">
                <field name="vender"/>
                <field name="purchase_order"/>
                <field name="buyer"/>
                <field name="product"/>
                <field name="product_category"/>
                <field name="qty_ordered"/>
                <field name="qty_received"/>
                <field name="qty_billed"/>
                <field name="unit_price"/>
                <field name="total_amount"/>
                <field name="ordered_date"/>
                <field name="expected_arrival"/>
                <field name="state"/>
            </list>
        </field>
    </record>


    <!-- action -->
    <record id="action_purchase_analysis_report" model="ir.actions.act_window">
        <field name="name">Purchase Analysis Report</field>
        <field name="res_model">purchase.analysis.report</field>
        <field name="view_mode">list</field>
    </record>

    <!-- menu -->
    <menuitem
        id="menu_purchase_analysis_report"
        name="Analysis report"
        parent="purchase.menu_purchase_root"
        action="action_purchase_analysis_report"
        sequence="110"
    />
</odoo>